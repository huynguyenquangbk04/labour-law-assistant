# Backend Settings
DATABASE_URL=postgresql://postgres:postgres@db:5432/law_assistant
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=law_assistant

# OpenRouter / Ollama / OpenAI-compatible API Configuration
BASE_URL=https://openrouter.ai/api/v1
API_KEY=your_api_key_here

# Model Configurations
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_QUERY_SENTENCE=
LLM_MODEL=deepseek/deepseek-v3.2

# LangGraph Configuration
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=deepseek/deepseek-v3.2
TAVILY_API_KEY=your_tavily_api_key_here

# Working Directories
WORKING_DIR=./backend/data
LIGHTRAG_WORKING_DIR=./backend/core/lightrag_project
GRAPHRAG_WORKING_DIR=./backend/core/graphrag_project

# RAG Settings
SUMMARY_LANGUAGE=Vietnamese
# Shared graph schema: JSON objects with type names as keys and descriptions as values.
# Both extraction engines read these settings. Restart the backend after editing.
APP_ENTITY_TYPE_DESCRIPTIONS='{"VanBanPhapLuat": "Văn bản pháp luật có số hiệu và nguồn; không phải hợp đồng cá nhân.", "Chuong": "Chương trong một văn bản.", "Muc": "Mục trong một chương.", "Dieu": "Điều trong một văn bản.", "Khoan": "Khoản trong một điều.", "Diem": "Điểm trong một khoản, gồm cả điểm đ.", "ChuThe": "Người, nhóm người, cơ quan, tổ chức hoặc chức danh pháp lý.", "KhaiNiem": "Khái niệm, hành vi, đối tượng, chế độ hoặc thủ tục pháp lý.", "QuyTac": "Một mệnh đề quyền, nghĩa vụ, cấm, thẩm quyền hoặc bước thủ tục, gắn nguồn.", "DieuKien": "Điều kiện, tình huống hoặc ngoại lệ của một quy tắc cụ thể."}'
APP_EDGE_TYPE_DESCRIPTIONS='{"CONTAINS": "Đơn vị cha -> đơn vị con trực tiếp; không tự tạo cấp bị thiếu.", "REFERENCES": "Đơn vị dẫn chiếu -> đơn vị được dẫn chiếu, đúng văn bản/khoản/điểm.", "BASED_ON": "Văn bản -> văn bản làm căn cứ.", "ISSUED_BY": "Văn bản -> chủ thể ban hành.", "DEFINES": "Đơn vị văn bản -> khái niệm/chủ thể được định nghĩa.", "IS_A": "Loại cụ thể -> loại tổng quát.", "STATES_RULE": "Đơn vị văn bản -> quy tắc được nêu tại đó.", "APPLIES_TO": "Quy tắc -> chủ thể; ghi vai trò người hưởng quyền/người có nghĩa vụ/cơ quan có thẩm quyền.", "HAS_OBJECT": "Quy tắc -> khái niệm/đối tượng được điều chỉnh.", "HAS_CONDITION": "Quy tắc -> điều kiện; giữ AND/OR/NOT và mệnh đề ngoại lệ.", "EXCEPTION_TO": "Quy tắc ngoại lệ -> quy tắc chung, chỉ khi có căn cứ rõ ràng.", "HAS_STEP": "Thủ tục -> bước thực hiện.", "PRECEDES": "Bước trước -> bước sau, chỉ khi văn bản quy định thứ tự.", "ENDS_EFFECT_OF": "Văn bản/quy định mới -> văn bản/quy định hết hiệu lực; giữ phạm vi và thời điểm.", "AMENDS": "Văn bản sửa đổi -> văn bản/đơn vị bị sửa đổi; không suy từ sửa đổi hợp đồng."}'
