# Backend Settings
DATABASE_URL=postgresql://postgres:postgres@db:5432/law_assistant
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=law_assistant

# OpenRouter / Ollama / OpenAI-compatible API Configuration
BASE_URL=https://openrouter.ai/api/v1
API_KEY=your_api_key_here

# Model Configurations
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_QUERY_SENTENCE=
LLM_MODEL=deepseek/deepseek-v3.2

# LangGraph Configuration
OPENAI_MODEL=deepseek/deepseek-v3.2
TAVILY_API_KEY=your_tavily_api_key_here

# LightRAG Settings
LIGHTRAG_WORKING_DIR=./backend/data
SUMMARY_LANGUAGE=Vietnamese
APP_ENTITY_TYPES=["Văn bản pháp luật", "Điều khoản", "Cơ quan ban hành", "Đối tượng áp dụng", "Hành vi vi phạm", "Hình thức xử phạt", "Thời hạn", "Khái niệm pháp lý"]
